# Sao chép thành .env (nếu dùng docker compose --env-file .env) hoặc export trước khi chạy.

# Mật khẩu PostgreSQL (bắt buộc cho backend)
DB_PASSWORD=postgres

# Khoá ký JWT (có giá trị mặc định trong application.properties, nên đổi ở môi trường thật)
JWT_SECRET=rental-housing-network-secret-key-please-change-in-production-0123456789

# SMTP Gmail App Password (dùng cho gửi email xác minh / quên mật khẩu / thông báo hoá đơn)
MAIL_USERNAME=
MAIL_PASSWORD=
